# LLM: any OpenAI-compatible endpoint (a cloud API or a local vLLM server).
# Swapping between them is just these three lines, no code changes.
LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=http://localhost:8001/v1    # example: local vLLM server instead
LLM_API_KEY=your-key-here
LLM_MODEL=gpt-4o-mini

# Embeddings: runs locally on CPU, no GPU or API key required.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Qdrant (the "qdrant" hostname is the service name from docker-compose.yml)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ragbox

# Chunking / retrieval (optional, sensible defaults shown)
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# TOP_K=4
